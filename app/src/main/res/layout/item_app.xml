<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="7dp"
        android:background="@drawable/bg_card"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="22dp"
        android:paddingEnd="12dp"
        android:paddingBottom="20dp">

    <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

        <ImageView
                android:id="@+id/icon"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_icon_ring"
                android:clipToOutline="true"
                android:outlineProvider="background"
                android:padding="3dp" />

        <com.othershe.cornerlabelview.CornerLabelView
                android:id="@+id/cornerLabel"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="top|start"
                android:visibility="invisible"
                app:bg_color="@color/ac_red"
                app:position="left_top"
                app:side_length="22dp"
                app:text="XP"
                app:text_color="@color/white"
                app:text_size="8sp" />
    </FrameLayout>

    <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/ac_text"
            android:textSize="17sp"
            android:textStyle="bold" />

    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_pill"
            android:paddingStart="26dp"
            android:paddingTop="7dp"
            android:paddingEnd="26dp"
            android:paddingBottom="7dp"
            android:text="@string/launch_game"
            android:textColor="@color/ac_red"
            android:textSize="14sp"
            android:textStyle="bold" />

</LinearLayout>
